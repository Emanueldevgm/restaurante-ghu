        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^8.0.10",
        "pg": "^8.21.0",
        "uuid": "^14.0.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
