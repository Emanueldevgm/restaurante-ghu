{
    
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "start:prod": "NODE_ENV=production node dist/server.js",
        "db:init": "psql postgresql://%DB_USER%:%DB_PASSWORD%@%DB_HOST%:%DB_PORT%/%DB_NAME% -f database/Banco.sql",
        "test": "jest",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "restaurant",
        "api",
        "express",
        "typescript",
        "postgresql",
        "angola"
    ],
